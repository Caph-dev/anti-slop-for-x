{
  "name": "anti-slop-for-x",
  "private": true,
  "version": "0.3.0",
  "description": "Detect and fold AI-slop / bot replies on X (x.com)",
  "workspaces": [
    "extension",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w extension",
    "build": "npm run build -w extension",
    "zip": "npm run zip -w extension",
    "unpacked": "npm run build && node scripts/sync-unpacked.mjs",
    "release:build": "npm run typecheck && npm run test && npm run zip && node scripts/sync-unpacked.mjs",
    "test": "npm run test -w extension",
    "typecheck": "npm run typecheck -w extension",
    "worker:dev": "npm run dev -w worker",
    "worker:start": "npm run start -w worker"
  },
  "author": "Caph-dev",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true
  }
}
